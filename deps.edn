{:paths ["src" "resources"]
 :deps {}
 :aliases
 {:kotoba {:replace-paths ["src"]
           ;; amu 9092ee34 (origin/main, 2026-09-08) is an explicit FLOOR, and
           ;; the reason lives here because a deps.edn :git/sha has no gate:
           ;; the previous pin f6ee539e refuses string-code-point-at
           ;; ("operation has no admitted lowering", measured 2026-09-08),
           ;; which is the primitive src/search/bounded_search.kotoba's
           ;; tokenizer walks. Do not move it backwards without re-measuring
           ;; that kernel on both targets.
           :replace-deps {io.github.kotoba-lang/amu
                          {:git/sha "9092ee34cc32b53ca998c473f7172e2f172abd8b"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
